# Zeitzone für Container
TZ=Europe/Berlin
# Vollqualifizierter Domainname des Mailservers
FQDN=mail.example.com
# UID für Maildir-Dateien im Container
MAIL_UID=1000
# GID für Maildir-Dateien im Container
MAIL_GID=1000
# Pfad zu Zertifikaten auf dem Host (Heimnetz: ./certs, VPS: /etc/letsencrypt)
CERTS_HOST_PATH=./certs
# Zertifikatsmodus: home (Self-Signed) oder vps (Let's Encrypt via Certbot)
CERT_MODE=home
# E-Mail-Adresse für Let's-Encrypt-Registrierung (VPS)
CERTBOT_EMAIL=admin@example.com
# true aktiviert Let's-Encrypt-Staging (VPS-Tests)
CERTBOT_STAGING=false
# Erneuerungsintervall für Certbot in Sekunden (Standard: 12 Stunden)
CERTBOT_RENEW_INTERVAL=43200
